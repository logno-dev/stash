{
  "manifest_version": 3,
  "name": "Stash",
  "version": "1.0.1",
  "description": "Save bookmarks and notes to your personal stash",
  
  "permissions": ["activeTab", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],

  "options_ui": { "page": "settings.html", "open_in_tab": true },
  
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Stash",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  
  "browser_specific_settings": {
    "gecko": {
      "id": "stash@bunch.codes",
      "strict_min_version": "121.0",
      "update_url": "https://logno-dev.github.io/stash/browser-extension-firefox/updates.json"
    }
  },
  
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Open Stash popup"
    },
    "open-notes-tab": {
      "suggested_key": {
        "default": "Alt+Shift+N",
        "mac": "Alt+Shift+N"
      },
      "description": "Open Stash popup to notes tab"
    },
    "open-search-tab": {
      "suggested_key": {
        "default": "Alt+Shift+K",
        "mac": "Alt+Shift+K"
      },
      "description": "Open Stash popup to search tab"
    }
  }
}
